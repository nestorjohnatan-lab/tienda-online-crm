# Entorno de aplicación (Twelve-Factor App)
NODE_ENV=development
PORT=3100
LOG_LEVEL=info

# Orígenes permitidos (CORS estricto)
CORS_TIENDA_ORIGIN=http://localhost:5173
CORS_CRM_ORIGIN=http://localhost:5174

# MariaDB local (usar usuario de mínimo privilegio creado en database/migrations/002_least_privilege_user.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tienda_crm
DB_USER=tienda_crm_app
DB_PASSWORD=REEMPLAZAR_EN_ENTORNO_LOCAL
DB_POOL_LIMIT=10

# Autenticación JWT Stateless (generar secretos aleatorios >= 32 bytes)
JWT_ACCESS_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_LARGO
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false

# Idempotencia y protección contra abuso
IDEMPOTENCY_TTL_HOURS=24
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
